---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/services" — combined with site for canonical + og:url */
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://bullseyestrategiesllc.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#0e1b2e" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Bullseye Strategies" />
    <meta property="og:image" content={new URL("/og-image.png", canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: "Bullseye Strategies, LLC",
        description:
          "Fractional CFO leadership, ERP implementation, FP&A and operational consulting for mid-market companies. Certified Disability-Owned Business Enterprise (DOBE).",
        url: "https://bullseyestrategiesllc.com",
        founder: { "@type": "Person", name: "Douglas Dillard" },
        areaServed: "United States",
        serviceType: [
          "Fractional CFO",
          "ERP Implementation",
          "FP&A and Analytics",
          "SOP Development",
          "Risk Advisory",
          "AI Integration",
        ],
      })}
    />
  </head>

  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-crimson-500 focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >

    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script is:inline>
      // Reveal-on-scroll. The .js-ready class gates the hidden state in CSS so
      // that if this script never runs, content stays visible rather than blank.
      (function () {
        var reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduced) return;

        document.documentElement.classList.add("js-ready");

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
        );

        document.querySelectorAll("[data-reveal]").forEach(function (el, i) {
          // Stagger items within the same group for a cascading entrance
          var group = el.getAttribute("data-reveal");
          if (group === "stagger") {
            el.style.setProperty("--reveal-delay", (i % 6) * 70 + "ms");
          }
          io.observe(el);
        });

        // Count-up statistics
        var counters = document.querySelectorAll("[data-count-to]");
        var co = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              co.unobserve(el);
              var target = parseFloat(el.getAttribute("data-count-to"));
              var suffix = el.getAttribute("data-count-suffix") || "";
              var prefix = el.getAttribute("data-count-prefix") || "";
              var dur = 1400;
              var start = performance.now();
              function tick(now) {
                var p = Math.min((now - start) / dur, 1);
                // easeOutExpo
                var eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
                var val = Math.round(target * eased);
                el.textContent = prefix + val.toLocaleString("en-US") + suffix;
                if (p < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach(function (el) {
          co.observe(el);
        });
      })();
    </script>
  </body>
</html>
