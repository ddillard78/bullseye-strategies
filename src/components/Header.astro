---
import Logo from "./Logo.astro";
import { BOOKING_URL, NAV } from "../data/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent"
  data-scrolled="false"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-8"
  >
    <a href="/" class="shrink-0" aria-label="Bullseye Strategies — home">
      <Logo />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.href ? "page" : undefined}
            class:list={[
              "link-underline text-[0.8rem] font-semibold uppercase tracking-[0.1em] transition-colors",
              current === item.href
                ? "text-white"
                : "text-slate-350 hover:text-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener"
        class="hidden rounded-full bg-crimson-500 px-5 py-2.5 text-[0.78rem] font-bold uppercase tracking-[0.1em] text-white transition-colors hover:bg-crimson-600 sm:inline-block"
      >
        Book a Call
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="grid h-10 w-10 place-items-center rounded-md text-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Reading progress rule -->
  <div
    class="scroll-progress h-px w-full origin-left bg-crimson-500"
    aria-hidden="true"
  >
  </div>

  <div
    id="mobile-nav"
    hidden
    class="border-t border-white/10 bg-navy-950/95 px-5 pb-6 pt-4 backdrop-blur lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-2 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-slate-350 hover:bg-white/5 hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener"
        class="mt-3 rounded-full bg-crimson-500 px-5 py-3 text-center text-sm font-bold uppercase tracking-[0.1em] text-white"
      >
        Book a Call
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector(".site-header");
    var onScroll = function () {
      header.setAttribute("data-scrolled", window.scrollY > 24 ? "true" : "false");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    var toggle = document.getElementById("nav-toggle");
    var panel = document.getElementById("mobile-nav");
    toggle.addEventListener("click", function () {
      var open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
    });
  })();
</script>
