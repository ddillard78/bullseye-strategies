---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import {
  CONTACT,
  BOOKING_URL,
  AWARDS,
  SPEAKING,
  BOARDS,
  CREDENTIALS,
  PROOF,
} from "../data/site";
import doug from "../assets/Doug_Dillard_1765144821802.jpeg";
import racing from "../assets/doug_racing_houston.jpg";

const values = [
  {
    title: "Integrated thinking",
    body: "We reject silos. Finance has to understand operations. Operations has to understand the system. Most of the value sits in the seams between them, which is exactly where nobody is looking.",
  },
  {
    title: "Bias for action",
    body: "Strategy without execution is hallucination. We deliver tangible assets — models, manuals, configured systems, secured capital — not a recommendation to go build them.",
  },
  {
    title: "Radical candor",
    body: "We tell you what you need to hear. If the answer is that your problem is a person rather than a process, or that you do not need us, you will hear that too.",
  },
];
---

<Base
  title="About Douglas Dillard | Bullseye Strategies"
  description="Douglas Dillard, MBA — CFO and COO with 20+ years at companies from $5M to $350M in revenue. Named one of the 10 Best CFOs of 2022 and twice a Houston Business Journal CFO of the Year finalist."
  path="/about"
>
  <PageHero
    eyebrow="The Founder"
    title="Douglas Dillard, MBA"
    lede="An operating CFO who never stopped being comfortable under the hood."
  />

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div data-reveal>
        <div class="overflow-hidden rounded-xl border border-paper-200">
          <Image
            src={doug}
            alt="Douglas Dillard, founder of Bullseye Strategies"
            widths={[400, 700]}
            sizes="(min-width: 1024px) 34vw, 90vw"
            class="w-full object-cover"
          />
        </div>

        <dl class="mt-8 grid grid-cols-3 gap-4 text-center">
          {
            [
              ["20+", "Years"],
              ["$350M", "Largest P&L"],
              ["MBA", "Accounting"],
            ].map(([v, l]) => (
              <div class="rounded-lg border border-paper-200 bg-white px-2 py-4">
                <dt class="font-[var(--font-display)] text-xl font-extrabold text-navy-900">
                  {v}
                </dt>
                <dd class="mt-1 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-navy-700/60">
                  {l}
                </dd>
              </div>
            ))
          }
        </dl>

        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener"
          class="mt-6 block rounded-full border border-navy-900/20 px-6 py-3 text-center text-xs font-bold uppercase tracking-[0.12em] text-navy-900 transition-colors hover:bg-navy-900 hover:text-white"
          >Connect on LinkedIn</a
        >

        <ul class="mt-8 space-y-2 text-sm text-navy-800/70">
          {CREDENTIALS.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div class="space-y-6 text-[1.05rem] leading-relaxed text-navy-800/80">
        <p data-reveal>
          Twenty years running finance and operations at companies from $5M to
          $350M in revenue&mdash;most recently as COO, Principal, and board
          member at Moderno Porcelain Works, where thirteen locations each ran
          as a distinct P&amp;L.
        </p>
        <p data-reveal>
          As CFO of DC Partners he closed over $400 million in construction
          financing&mdash;including a $175M syndicated deal&mdash;on Houston
          urban-core developments: Thompson Hotels &amp; Residences, The Allen,
          the Arabella, the Marlowe, the Astoria. Earlier, at Cosentino North
          America, he ran FP&amp;A for a 25-subsidiary consolidation group and
          cut month-end close from fifteen days to five.
        </p>
        <p data-reveal>
          What distinguishes him is range: equally comfortable presenting to a
          board, mapping SOPs with a warehouse supervisor, or configuring the
          ERP module neither of them wants to own. In most firms those are three
          different people who do not talk to each other. That gap is why this
          one exists.
        </p>

        <blockquote
          class="border-l-2 border-crimson-500 pl-6 text-xl font-medium leading-relaxed text-navy-900"
          data-reveal
        >
          &ldquo;I built Bullseye to be the partner I always wished I had as a
          CFO&mdash;someone who understands the numbers but also knows how to fix
          the engine.&rdquo;
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ADAPTIVE ATHLETE -->
  <section class="bg-navy-950 py-20 text-white sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div class="overflow-hidden rounded-xl border border-white/10" data-reveal>
          <Image
            src={racing}
            alt="Douglas Dillard racing in his wheelchair at the UTHealth Houston Half Marathon, wearing a Bee Abled jersey"
            widths={[500, 800]}
            sizes="(min-width: 1024px) 32vw, 90vw"
            class="scroll-zoom w-full object-cover"
          />
        </div>

        <div data-reveal>
          <p class="eyebrow">Why This Is On The Page</p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight sm:text-[2.4rem]">
            Fifty-plus races, and what they have to do with your close
            process.
          </h2>
          <div class="mt-6 space-y-5 text-[1.05rem] leading-relaxed text-slate-350">
            <p>
              More than fifty marathons, half marathons, and races as an
              adaptive athlete &mdash; including Boston &mdash; and a 2023
              Houston Sports Hall of Fame Honoree as Inspiring Adaptive Athlete
              of the Year.
            </p>
            <p>
              It is here for a reason that has little to do with fitness. The
              discipline that finishes a marathon is the discipline that closes
              the books on the fifth business day, every month, without heroics.
              Both are won in the boring middle, long after motivation has worn
              off. That is the temperament being hired.
            </p>
            <p class="border-l-2 border-crimson-500 pl-5 text-base text-white/80">
              The jersey in that photo is Bee Abled, the 501(c)(3) where Douglas
              serves as Board Member and Treasurer.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SELECTED RESULTS -->
  <section class="bg-paper-100 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Selected Results</p>
        <h2
          class="mt-4 text-3xl font-extrabold leading-tight text-navy-900 sm:text-[2.6rem]"
        >
          Specific numbers, attached to specific engagements.
        </h2>
        <p class="mt-5 leading-relaxed text-navy-800/70">
          Each figure names the company it came from. Consulting is full of
          unattributed statistics; these are checkable.
        </p>
      </div>

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          PROOF.map((p) => (
            <div
              class="lift rounded-xl border border-paper-200 bg-white p-7 hover:border-crimson-500/40"
              data-reveal="stagger"
            >
              <p class="font-[var(--font-display)] text-2xl font-extrabold tracking-tight text-crimson-600">
                {p.metric}
              </p>
              <p class="mt-1 text-sm font-bold uppercase tracking-[0.08em] text-navy-900">
                {p.label}
              </p>
              <p class="mt-4 text-sm leading-relaxed text-navy-800/70">
                {p.context}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RECOGNITION -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-14 lg:grid-cols-3 lg:gap-12">
      <div data-reveal>
        <p class="eyebrow">Recognition</p>
        <h2 class="mt-4 text-2xl font-extrabold text-navy-900">Awards</h2>
        <ul class="mt-6 space-y-5">
          {
            AWARDS.map((a) => (
              <li class="border-l-2 border-crimson-500 pl-4">
                <p class="text-[0.7rem] font-bold uppercase tracking-[0.12em] text-navy-700/60">
                  {a.year}
                </p>
                <p class="mt-1 font-bold text-navy-900">{a.title}</p>
                <p class="text-sm text-navy-800/70">{a.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal>
        <p class="eyebrow">Platform</p>
        <h2 class="mt-4 text-2xl font-extrabold text-navy-900">Speaking</h2>
        <ul class="mt-6 space-y-5">
          {
            SPEAKING.map((s) => (
              <li class="border-l-2 border-paper-200 pl-4">
                <p class="text-[0.7rem] font-bold uppercase tracking-[0.12em] text-navy-700/60">
                  {s.year}
                </p>
                <p class="mt-1 font-bold text-navy-900">{s.title}</p>
                <p class="text-sm leading-relaxed text-navy-800/70">
                  {s.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal>
        <p class="eyebrow">Service</p>
        <h2 class="mt-4 text-2xl font-extrabold text-navy-900">
          Board &amp; Civic
        </h2>
        <ul class="mt-6 space-y-5">
          {
            BOARDS.map((b) => (
              <li class="border-l-2 border-paper-200 pl-4">
                <p class="text-[0.7rem] font-bold uppercase tracking-[0.12em] text-navy-700/60">
                  {b.years}
                </p>
                <p class="mt-1 font-bold text-navy-900">{b.role}</p>
                <p class="text-sm text-navy-800/70">{b.org}</p>
                {b.detail && (
                  <p class="mt-2 text-sm leading-relaxed text-navy-800/60">
                    {b.detail}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- DOBE -->
  <section class="bg-maroon-700 py-20 text-white sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8" data-reveal>
      <p class="text-[0.68rem] font-bold uppercase tracking-[0.16em] text-white/70">
        Certification
      </p>
      <h2 class="mt-4 text-3xl font-extrabold leading-tight sm:text-4xl">
        A Certified Disability-Owned Business Enterprise
      </h2>
      <p class="mt-5 leading-relaxed text-white/85">
        Bullseye Strategies, LLC is certified by Disability:IN as a
        Disability-Owned Business Enterprise&mdash;certificate US01708, valid
        through July 30, 2029. Fewer than 1,100 businesses worldwide hold this
        certification. Resilience here is not a slogan on a values page; it is
        lived experience, on the racecourse and in the boardroom.
      </p>
      <a
        href="/dobe-certified"
        class="mt-8 inline-block rounded-full bg-white px-7 py-3.5 text-sm font-bold uppercase tracking-[0.1em] text-maroon-700 transition-colors hover:bg-paper-100"
        >View the Certificate</a
      >
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Our DNA</p>
      <h2
        class="mt-4 text-3xl font-extrabold leading-tight text-navy-900 sm:text-[2.6rem]"
      >
        Precision. Resilience. Integrity.
      </h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        values.map((v) => (
          <div
            class="lift rounded-xl border border-paper-200 bg-white p-8 hover:border-crimson-500/40"
            data-reveal="stagger"
          >
            <h3 class="text-xl font-bold text-navy-900">{v.title}</h3>
            <p class="mt-4 leading-relaxed text-navy-800/70">{v.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rings bg-navy-900 py-20 text-center text-white sm:py-24">
    <div class="mx-auto max-w-2xl px-5 sm:px-8" data-reveal>
      <h2 class="text-3xl font-extrabold sm:text-4xl">Ready to work together?</h2>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-block rounded-full bg-crimson-500 px-8 py-4 text-sm font-bold uppercase tracking-[0.1em] text-white transition-colors hover:bg-crimson-600"
        >Schedule a Discovery Call</a
      >
    </div>
  </section>
</Base>
