---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { CONTACT, BOOKING_URL, SERVICES } from "../data/site";

/**
 * Static sites cannot send email on their own. This form posts to Web3Forms,
 * which relays the submission to CONTACT.email. The free tier covers far more
 * than this site will ever receive.
 *
 * SETUP REQUIRED: request an access key at https://web3forms.com (it is emailed
 * to you, no account needed) and paste it below. Until then the form renders
 * but submissions will fail, so the notice below stays visible.
 */
const WEB3FORMS_KEY = "1746c451-2384-4403-9426-d705d6443e24";
const formConfigured = !WEB3FORMS_KEY.startsWith("REPLACE_WITH");
---

<Base
  title="Contact | Bullseye Strategies"
  description="Get in touch with Bullseye Strategies — Houston, Texas. Schedule a complimentary discovery call or send a message directly."
  path="/contact"
>
  <PageHero
    eyebrow="Get In Touch"
    title="Let's find out if we can help."
    lede="A discovery call runs about 45 minutes. No deck, no pitch — a structured conversation about where the numbers stop being trustworthy."
  />

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <!-- FORM -->
      <div data-reveal>
        {
          !formConfigured && (
            <div class="mb-7 rounded-lg border border-crimson-500/30 bg-crimson-500/5 p-5 text-sm leading-relaxed text-navy-900">
              <strong class="font-bold">Setup required:</strong> this form needs
              a free Web3Forms access key before it can deliver mail. See the
              comment at the top of <code>src/pages/contact.astro</code>.
            </div>
          )
        }

        <form id="contact-form" class="space-y-5">
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input
            type="hidden"
            name="subject"
            value="New enquiry from bullseyestrategies.net"
          />
          <!-- Honeypot: bots fill this, humans never see it -->
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="block text-sm font-semibold text-navy-900" for="name"
                >Name</label
              >
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-2 w-full rounded-lg border border-paper-200 bg-white px-4 py-3 text-navy-900 outline-none transition-colors focus:border-crimson-500"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-navy-900" for="company"
                >Company</label
              >
              <input
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
                class="mt-2 w-full rounded-lg border border-paper-200 bg-white px-4 py-3 text-navy-900 outline-none transition-colors focus:border-crimson-500"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="block text-sm font-semibold text-navy-900" for="email"
                >Email</label
              >
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-2 w-full rounded-lg border border-paper-200 bg-white px-4 py-3 text-navy-900 outline-none transition-colors focus:border-crimson-500"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-navy-900" for="phone"
                >Phone <span class="font-normal text-navy-700/50">(optional)</span></label
              >
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="mt-2 w-full rounded-lg border border-paper-200 bg-white px-4 py-3 text-navy-900 outline-none transition-colors focus:border-crimson-500"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-navy-900" for="interest"
              >What do you need help with?</label
            >
            <select
              id="interest"
              name="interest"
              class="mt-2 w-full rounded-lg border border-paper-200 bg-white px-4 py-3 text-navy-900 outline-none transition-colors focus:border-crimson-500"
            >
              <option value="">Not sure yet</option>
              {SERVICES.map((s) => <option value={s.title}>{s.title}</option>)}
              <option value="Something else">Something else</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-navy-900" for="message"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="A sentence or two about the situation is plenty."
              class="mt-2 w-full rounded-lg border border-paper-200 bg-white px-4 py-3 text-navy-900 outline-none transition-colors focus:border-crimson-500"
            ></textarea>
          </div>

          <button
            type="submit"
            class="rounded-full bg-crimson-500 px-8 py-3.5 text-sm font-bold uppercase tracking-[0.1em] text-white transition-colors hover:bg-crimson-600 disabled:opacity-60"
            >Send Message</button
          >

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="text-sm font-medium"
          >
          </p>
        </form>
      </div>

      <!-- DETAILS -->
      <aside class="space-y-5" data-reveal>
        <div class="rounded-xl border border-paper-200 bg-white p-7">
          <h2 class="text-lg font-bold text-navy-900">Prefer to just book?</h2>
          <p class="mt-2 text-sm leading-relaxed text-navy-800/70">
            Skip the form and take a slot directly on the calendar.
          </p>
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-block rounded-full bg-navy-900 px-6 py-3 text-xs font-bold uppercase tracking-[0.1em] text-white transition-colors hover:bg-navy-800"
            >Open the Calendar</a
          >
        </div>

        <div class="rounded-xl border border-paper-200 bg-white p-7">
          <h2 class="text-lg font-bold text-navy-900">Direct</h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a
                class="link-underline text-navy-800 hover:text-crimson-600"
                href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a
              >
            </li>
            <li>
              <a
                class="link-underline text-navy-800 hover:text-crimson-600"
                href={CONTACT.phoneHref}>{CONTACT.phone}</a
              >
            </li>
            <li class="text-navy-800">{CONTACT.location}</li>
            <li>
              <a
                class="link-underline text-navy-800 hover:text-crimson-600"
                href={CONTACT.linkedin}
                target="_blank"
                rel="noopener">LinkedIn</a
              >
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-paper-200 bg-paper-100 p-7">
          <h2 class="text-lg font-bold text-navy-900">Security teams welcome</h2>
          <p class="mt-2 text-sm leading-relaxed text-navy-800/70">
            If your IT, compliance, or audit group needs to review how client
            data is handled before engaging, start with our data security page
            &mdash; then book a call with them on it.
          </p>
          <a
            href="/data-security"
            class="link-underline mt-4 inline-block text-xs font-bold uppercase tracking-[0.12em] text-navy-900"
            >Read the data security brief &rarr;</a
          >
        </div>
      </aside>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var form = document.getElementById("contact-form");
    var status = document.getElementById("form-status");
    if (!form) return;

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      status.textContent = "Sending…";
      status.className = "text-sm font-medium text-navy-700";

      try {
        var res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        var data = await res.json();
        if (res.ok && data.success) {
          form.reset();
          status.textContent =
            "Thank you — your message is through. You'll hear back within one business day.";
          status.className = "text-sm font-medium text-green-700";
        } else {
          throw new Error(data.message || "Submission failed");
        }
      } catch (err) {
        status.innerHTML =
          'Something went wrong sending that. Please email <a class="underline" href="mailto:douglas@bullseyestrategies.net">douglas@bullseyestrategies.net</a> directly.';
        status.className = "text-sm font-medium text-crimson-600";
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>
